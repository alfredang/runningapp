<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export an App Store build for upload via altool / Transporter. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>GU9WTSTX9M</string>
	<!-- Use the installed App Store profile; the ASC API key cannot mint cloud-managed profiles. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution: Alfred Ang (GU9WTSTX9M)</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.tertiaryinfotech.runtrackgps</key>
		<string>RunTrackGPS AppStore</string>
	</dict>
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- App Store builds should not include bitcode (deprecated). -->
	<key>uploadBitcode</key>
	<false/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
