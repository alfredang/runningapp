<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>RunTrack GPS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- ===== Permissions ===== -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app uses your location to track your running route.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>This app needs background location access to continue tracking your run.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app uses the microphone for voice commands.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>This app uses speech recognition to control your running session.</string>

	<!-- ===== Background Modes ===== -->
	<!-- `location`: persistent GPS tracking while the run is backgrounded.
	     `audio`: REQUIRED for the audio-coaching feature. iOS discards ALL audio output
	     from a backgrounded app that does not declare this mode — the `location` mode keeps
	     the process alive (so the synthesizer runs and reports success) but the audio is
	     routed nowhere, which is why coaching was silent on a locked phone.
	     This was briefly removed after an App Review 2.5.4 rejection, but removing it
	     removed the feature. RunTrack now works like other GPS running apps (Nike Run
	     Club, Strava, Runkeeper): the audio session is held ACTIVE for the entire duration
	     of a run — a continuous coaching session the runner starts and stops deliberately —
	     rather than being claimed intermittently for one-off alerts. See
	     SpeechFeedbackManager.beginRunAudioSession(). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>

	<!-- ===== App Store compliance ===== -->
	<!-- App uses no non-exempt encryption → skips the export-compliance prompt on upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 64-bit only (never legacy armv7), plus GPS hardware: this is a GPS running app,
	     so it must not be offered on / reviewed on devices without a GPS receiver
	     (e.g. Wi-Fi iPads). `gps` implies location-services. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>gps</string>
		<string>location-services</string>
	</array>
</dict>
</plist>
